# Copy this to .env and fill in what you need. Nothing here is committed.

# Required to run a live goal. Without it the pipeline fails on the first
# model call, which is the expected behaviour offline.
ANTHROPIC_API_KEY=

# Which model the agents and planner use. Defaults are set in config.py.
# Set these to whatever you actually have access to.
STRANDS_MODEL=claude-sonnet-4-6
STRANDS_PLANNER_MODEL=claude-sonnet-4-6

# Retries per task and step cap per agent loop.
STRANDS_MAX_TASK_ATTEMPTS=3
STRANDS_MAX_AGENT_STEPS=12

# Replanning. The supervisor reviews the plan after each wave and can revise
# it. Turn it off to run in plain workflow mode (useful for A/B on the eval).
STRANDS_REPLAN=true
STRANDS_MAX_REPLANS=3

# Replanning. The supervisor reviews the run after each wave and can revise
# the plan. STRANDS_MAX_REPLANS bounds how many times it may look, which caps
# the supervisor's LLM cost regardless of plan size. Set STRANDS_REPLAN=false
# to run as a plain fixed-plan workflow (useful for A/B comparison in eval).
STRANDS_REPLAN=true
STRANDS_MAX_REPLANS=3

# GitHub issue writing. Both of these must be set for real writes to happen.
# Leave STRANDS_GITHUB_WRITE unset or false to stay in dry-run mode.
GITHUB_TOKEN=
STRANDS_GITHUB_WRITE=false

# Repo the demo would file issues against, as owner/name.
STRANDS_DEMO_REPO=your-name/strands-demo
